# O login com ChatGPT não precisa desta chave. Gateway é uma alternativa explícita.
AI_GATEWAY_API_KEY=
# Modelos confirmados no catálogo em 2026-10-19; podem ser alterados.
DETECTOR_MODEL=openai/gpt-4.1-mini
CHECKER_MODEL=openai/gpt-5.4-mini
TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
# Transcrição local usada com ChatGPT. "small" já foi testado neste computador.
LOCAL_ASR_MODEL=small
# Opcional se ffmpeg / Python não estiverem no PATH:
# FFMPEG_PATH=C:\caminho\ffmpeg.exe
# CHECK_FACT_PYTHON=C:\vs_code\check-fact\.venv\Scripts\python.exe

# Servidor web independente (npm run web). Sem estas variáveis, usa loopback.
# APP_PUBLIC_ORIGIN=https://verifica.seudominio.com.br
# PORT=4311
# HOST=127.0.0.1
# WEB_ACCESS_CODE=
