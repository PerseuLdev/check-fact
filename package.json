{
  "name": "check-fact-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checagem incremental de falas com painel local e overlay",
  "scripts": {
    "dev": "npx --yes --package=node@24 node --env-file-if-exists=.env node_modules/eve/bin/eve.js dev --host 127.0.0.1 --port 4310 --no-ui --no-default-extensions",
    "build": "npx --yes --package=node@24 node node_modules/eve/bin/eve.js build",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "guarded-fetch": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "^7.0.137",
    "eve": "^0.81.0",
    "jose": "^5.10.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "just-bash": "^3.6.0"
  }
}
